# Local development uses SQLite. Vercel replaces this with the Neon Postgres URL.
DATABASE_URL=file:./.db
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Public origin used for canonical URLs, Open Graph, robots.txt, and the sitemap.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Provided by Vercel after Blob storage is connected. Leave unset locally to store uploads on disk.
# BLOB_READ_WRITE_TOKEN=
